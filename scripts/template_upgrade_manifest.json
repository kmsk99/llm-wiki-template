    ".agents/skills/reindex/SKILL.md",
    ".agents/skills/score/SKILL.md",
    ".agents/skills/supersede/SKILL.md",
    ".agents/skills/trace-citation/SKILL.md",
    ".claude/commands/audit.md",
    ".claude/commands/catalog.md",
    ".claude/commands/extract-actions.md",
    ".claude/commands/generate.md",
    ".claude/commands/ingest.md",
    ".claude/commands/lint.md",
    ".claude/commands/query.md",
    ".claude/commands/reindex.md",
    ".claude/commands/score.md",
    ".claude/commands/supersede.md",
    ".claude/commands/trace-citation.md",
    ".claude/commands/verify.md",
    "SCHEMA.md",
    "prompts/README.md",
    "prompts/raw-to-wiki.md",
    "prompts/weekly-curation.md",
    "templates/README.md",
    "templates/decision-adr.md",
    "templates/entity.md",
    "templates/glossary-term.md",
    "templates/index-map.md",
    "templates/playbook.md",
    "templates/raw-note.md",
    "templates/wiki-page.md",
    "scripts/env_defaults.py",
    "scripts/parse-html.py",
    "scripts/parse-hwp.py",
    "scripts/parse-image.py",
    "scripts/parse-pdf.py",
    "scripts/parse-raw.sh",
    "scripts/parse-text.py",
    "scripts/parse_docling.py",
    "scripts/repair_parsed_artifacts.py",
    "scripts/setup.sh",
    "scripts/template_upgrade.py",
    "scripts/template_upgrade_manifest.json",
    "scripts/check_raw_immutable.py",
    "scripts/check_secrets.py",
    "scripts/sync_codex_skills.py",
    "scripts/install_hooks.py",
    "scripts/setup_core.py",
    "scripts/requirements-core.txt",
    "scripts/hooks/pre-commit",
