    "scripts/lint_gate.py",
    ".agents/skills/verify/SKILL.md",
    "PROJECT.example.md",
    "CORE.md"
  ],
  "json_merges": [
    {
      "path": ".claude/settings.json",
      "strategy": "deep_merge_unique"
    }
  ],
  "block_merges": [
    {
      "path": ".gitignore",
      "source_path": ".gitignore",
      "start_marker": "# >>> llm-wiki-template graphify >>>",
      "end_marker": "# <<< llm-wiki-template graphify <<<"
    },
    {
      "path": "AGENTS.md",
      "source_path": "AGENTS.md",
      "start_marker": "<!-- llm-wiki-template:core:start -->",
      "end_marker": "<!-- llm-wiki-template:core:end -->"
    },
    {
      "path": "CLAUDE.md",
      "source_path": "CLAUDE.md",
      "start_marker": "<!-- llm-wiki-template:core:start -->",
      "end_marker": "<!-- llm-wiki-template:core:end -->"
    }
  ],
  "exclude_paths": [
    "raw",
    "wiki",
    "output",
    "graphify-out",
    ".omx",
    ".omc",
    ".venv",
    ".obsidian",
    "tools",
    "PROJECT.md"
  ]
}
